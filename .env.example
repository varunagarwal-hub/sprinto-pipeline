# Copy to .env and fill in. .env is git-ignored.

# Gemini (google-genai SDK)
GEMINI_API_KEY=
# Leave blank to use the default Flash model set in pipeline/config.py
GEMINI_MODEL=

# Hunter.io Domain Search (this account: 50 searches/month)
HUNTER_API_KEY=
# mock = read fixtures/hunter_mock.json, spend nothing (default). live = real API calls.
HUNTER_MODE=mock

# Neon Postgres connection string (postgresql://user:pass@host/db?sslmode=require)
DATABASE_URL=

# Every approved email is sent to this address, never to the prospect.
# Without a verified Resend domain, this must be the email your Resend account is registered with.
MY_EMAIL=

# Resend (https://resend.com/api-keys). onboarding@resend.dev works without a verified domain.
RESEND_API_KEY=
RESEND_FROM=Sprinto Outreach <onboarding@resend.dev>
# Name used to sign the emails
SENDER_NAME=

# dev = cache all HTTP + Gemini responses on disk and use the Hunter mock
# prod = live calls (Hunter still asks for confirmation)
PIPELINE_ENV=dev
