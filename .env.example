# Copy to .env and fill in. .env is git-ignored.

# Gemini (google-genai SDK)
GEMINI_API_KEY=
# Leave blank to use the default Flash model set in pipeline/config.py
GEMINI_MODEL=

# Hunter.io Domain Search (free tier: 25 searches/month)
HUNTER_API_KEY=
# mock = read fixtures/hunter_mock.json, spend nothing (default). live = real API calls.
HUNTER_MODE=mock

# Neon Postgres connection string (postgresql://user:pass@host/db?sslmode=require)
DATABASE_URL=

# Every Gmail draft goes to this address, never to the prospect
MY_EMAIL=

# dev = cache all HTTP + Gemini responses on disk and use the Hunter mock
# prod = live calls (Hunter still asks for confirmation)
PIPELINE_ENV=dev
